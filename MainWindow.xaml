<Window x:Class="MultiInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiInstaller"
        Width="1000"
        Height="720"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Background="#F3F4F6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <Border Grid.Row="0"
                Background="#111827"
                Padding="28,22">

            <StackPanel>
                <TextBlock Text="MULTIINSTALLER"
                           Foreground="White"
                           FontSize="27"
                           FontWeight="Bold"/>

                <TextBlock Text="Aggiungi gli installer, seleziona i programmi e avvia tutto con un clic."
                           Foreground="#D1D5DB"
                           FontSize="14"
                           Margin="0,6,0,0"/>
            </StackPanel>

        </Border>

        <!-- Area aggiunta programmi -->
        <Border Grid.Row="1"
                Margin="22,20,22,10"
                Padding="24"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="2"
                CornerRadius="12"
                AllowDrop="True"
                DragOver="DropArea_DragOver"
                Drop="DropArea_Drop">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Trascina qui gli installer"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock Text="Sono supportati i file .exe e .msi"
                               FontSize="14"
                               Foreground="#6B7280"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="AddFilesButton"
                        Content="+ Scegli programmi"
                        Style="{StaticResource PrimaryButton}"
                        Click="AddFilesButton_Click"/>

            </Grid>

        </Border>

        <!-- Elenco -->
        <Border Grid.Row="2"
                Margin="22,10,22,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="14,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Programmi disponibili"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button Content="Seleziona tutti"
                                Style="{StaticResource SecondaryButton}"
                                Click="SelectAllButton_Click"/>

                        <Button Content="Deseleziona"
                                Style="{StaticResource SecondaryButton}"
                                Click="DeselectAllButton_Click"/>

                        <Button Content="Rimuovi"
                                Style="{StaticResource DangerButton}"
                                Click="RemoveButton_Click"/>

                    </StackPanel>

                </Grid>

                <DataGrid Grid.Row="1"
                          x:Name="InstallersGrid"
                          ItemsSource="{Binding Installers}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          SelectionMode="Single"
                          RowHeight="48"
                          FontSize="14"
                          Margin="8,0,8,8">

                    <DataGrid.Columns>

                        <DataGridCheckBoxColumn Header="Installa"
                                                Width="85"
                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn Header="Programma"
                                            Width="2*"
                                            IsReadOnly="True"
                                            Binding="{Binding Name}"/>

                        <DataGridTextColumn Header="File"
                                            Width="2*"
                                            IsReadOnly="True"
                                            Binding="{Binding FileName}"/>

                        <DataGridTextColumn Header="Stato"
                                            Width="1.4*"
                                            IsReadOnly="True"
                                            Binding="{Binding Status}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- Comandi installazione -->
        <Border Grid.Row="3"
                Margin="22,6,22,10"
                Padding="18"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="GeneralStatusText"
                                   Text="Pronto"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <ProgressBar x:Name="InstallationProgressBar"
                                     Height="15"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,9,20,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button x:Name="CancelButton"
                                Content="Annulla"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="CancelButton_Click"/>

                        <Button x:Name="InstallButton"
                                Content="AVVIA INSTALLAZIONI"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="16"
                                Click="InstallButton_Click"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

        <!-- Log -->
        <Border Grid.Row="4"
                Margin="22,0,22,20"
                Padding="14"
                Background="#111827"
                CornerRadius="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Registro operazioni"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox Grid.Row="1"
                         x:Name="LogTextBox"
                         Background="#111827"
                         Foreground="#D1D5DB"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"/>

            </Grid>

        </Border>

    </Grid>

</Window>
